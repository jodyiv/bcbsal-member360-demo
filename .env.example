# Demo mode
DEMO_MODE=mock
VITE_DEMO_MODE=mock

# API base
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEMO_TITLE="BCBS AL Member 360 Lakehouse — Built with IBM watsonx"
VITE_DEMO_CLIENT_CODE=DEMO-BCBSAL-001

# ── watsonx.data SaaS (Iceberg Lakehouse + Presto/Spark) ─────────────────────
# Leave blank for mock mode
WXDATA_HOST=
WXDATA_API_KEY=
WXDATA_INSTANCE_ID=
WXDATA_CATALOG=member360
WXDATA_SCHEMA=member360

# ── watsonx.data Integration SaaS (IBM App Connect pipelines) ────────────────
WXINTEGRATION_HOST=
WXINTEGRATION_API_KEY=

# ── watsonx.data Intelligence SaaS (IBM Knowledge Catalog) ───────────────────
WXINTELLIGENCE_HOST=
WXINTELLIGENCE_API_KEY=

# ── watsonx.ai (optional — for live LLM responses via AI assistant) ──────────
WATSONX_AI_API_KEY=
WATSONX_AI_PROJECT_ID=
WATSONX_AI_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=meta-llama/llama-4-maverick-17b-128e-instruct-fp8
