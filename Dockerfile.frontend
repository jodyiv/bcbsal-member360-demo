# DEPLOY_TARGET: openshift
# BUILD_ARCH: arm64
# Build on native arch to avoid QEMU/esbuild crashes on Apple Silicon
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/ubi9/nodejs-20 AS builder
WORKDIR /opt/app-root/src
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM --platform=linux/amd64 registry.access.redhat.com/ubi9/nginx-124
COPY --from=builder /opt/app-root/src/dist /usr/share/nginx/html
EXPOSE 8080
